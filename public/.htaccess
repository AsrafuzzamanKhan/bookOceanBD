<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle API requests
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ /api/index.php [L]

  # Handle React routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Browser caching - repeat visitors reuse a cached copy instead of
# re-downloading everything, so the site feels instant on a second visit.
#
# The one rule this must never break: HTML always revalidates. Every HTML
# file here (index.html, and every book/dashboard/category "shell" page -
# see scripts/generate-og-pages.cjs) is just a copy of the SAME built
# index.html, and it's what tells the browser which hashed JS/CSS files to
# load. If a browser cached an OLD index.html, it would keep asking for
# asset files that got deleted on the next deploy - the exact "site is
# blank/broken" failure this project already went through once. So HTML
# gets no-cache (always ask the server "has this changed?" first); the
# hashed JS/CSS it points to is safe to cache hard, since any content
# change always ships under a brand new filename (see main.jsx's
# window.__BOC_BUILD__ comment for why that matters).
#
# Plain images/JSON under /public (bg.png, services.json, etc.) are NOT
# filename-hashed, so a year-long cache could hide a real edit uploaded
# under the same name - 30 days is a middle ground between "feels instant"
# and "an image update actually shows up in a reasonable time".
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>